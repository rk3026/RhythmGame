linux.release.x86_64 = "res://addons/miniaudio_decoder/bin/linux/libminiaudio_decoder.linux.template_release.x86_64.so"
macos.debug = "res://addons/miniaudio_decoder/bin/macos/libminiaudio_decoder.macos.template_debug.framework"
